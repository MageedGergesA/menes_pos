# Mezze Edge backup config (copy to ${MEZZE_ETC}/backup.env, chmod 0600).
MEZZE_DB_NAME=${MEZZE_DB_NAME}
MEZZE_BACKUP_DIR=${MEZZE_VAR}/${MEZZE_DB_NAME}/backups
MEZZE_BACKUP_RETENTION_DAYS=14
# Optional off-site (used only when WAN is available; local backup never depends on it):
MEZZE_OFFSITE_ENABLED=false
MEZZE_OFFSITE_TARGET=
