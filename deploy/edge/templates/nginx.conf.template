# Mezze Edge reverse proxy — HTTPS terminate on LAN, proxy to Odoo + websocket.
upstream mezze_odoo { server 127.0.0.1:${MEZZE_ODOO_PORT}; }
upstream mezze_ws   { server 127.0.0.1:${MEZZE_GEVENT_PORT}; }

server {
    listen 80;
    server_name ${MEZZE_HOSTNAME};
    return 301 https://$host$request_uri;   # HTTP -> HTTPS
}

server {
    listen 443 ssl;
    server_name ${MEZZE_HOSTNAME};

    ssl_certificate     ${MEZZE_CERT_PATH};
    ssl_certificate_key ${MEZZE_CERT_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 100m;
    proxy_read_timeout 240s;
    proxy_connect_timeout 240s;

    access_log ${MEZZE_LOG}/nginx-access.log;
    error_log  ${MEZZE_LOG}/nginx-error.log;

    # websocket / longpolling bus
    location /websocket {
        proxy_pass http://mezze_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        proxy_pass http://mezze_odoo;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_cookie_flags session_id samesite=lax secure;
    }

    # do not expose the Odoo database manager to ordinary clients
    location /web/database/manager { deny all; return 404; }
    location /web/database/selector { deny all; return 404; }
}
