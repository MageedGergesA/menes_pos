<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- DESIGN FIDELITY (Register): the approved reference uses an IMAGE-LED card —
         a square thumbnail above a name/price band (reference: 141x227, 139x139
         image, 86px band, 14px radius). The shipped card was a 161x96 text-only
         tile. The image is the product's REAL Odoo image, served by the native
         session-authenticated /web/image route; products without one fall back to
         a neutral placeholder mark. No food imagery is fabricated. -->
    <t t-name="mezze_bridge.ProductGrid">
        <!-- The card-size control drives the grid HERE, on the grid element, rather
             than at :root. The admin's fixed-column setting still lives on
             :root[data-mz-grid-cols] and still wins on specificity — this is the
             cashier's own choice within it, which is what the design's
             Compact/Standard/Training strip actually is. -->
        <div class="mz-grid" t-ref="grid" t-att-data-mz-cards="props.density or 'standard'">
            <t t-if="!props.products.length">
                <div class="mz-grid-empty">No products in this category.</div>
            </t>
            <!-- DESIGN FIDELITY (quick-add): the reference card carries an explicit "+"
                 affordance in the bottom trailing corner (measured 27x27, radius 9,
                 12px/11px from the card edges). A native <button> may not contain
                 another interactive control, so the CARD CONTAINER is a plain <div>
                 and the two controls are SIBLINGS. The main control keeps the class
                 .mz-tile — it owns the canonical card surface (components.css) and is
                 what every existing test clicks — so nothing about the main product
                 button's semantics, disabled handling or focus changes. -->
            <div t-foreach="props.products" t-as="p" t-key="p.id" class="mz-tile-cell">
                <button type="button"
                        class="mz-tile"
                        t-att-class="{'mz-tile--out': p.available === false, 'mz-tile--kbd': p.id === props.highlightId}"
                        t-att-disabled="p.available === false ? 'disabled' : false"
                        t-att-data-product-id="p.id"
                        t-on-click="() => this.select(p)">
                    <span class="mz-tile__media" aria-hidden="true">
                        <!-- width/height are fixed by CSS, so the card never reflows while
                             the thumbnail decodes: no layout shift, no jumping grid. -->
                        <img t-if="p.has_image" class="mz-tile__img" loading="lazy" decoding="async"
                             alt="" t-att-src="imageUrl(p)"/>
                        <span t-else="" class="mz-tile__ph" t-esc="initials(p.name)"/>
                        <!-- DESIGN v3: priced by weight. On the media, because it
                             changes what tapping the card means — a weight is typed
                             and read back, never stepped. -->
                        <span t-if="isWeighed(p)" class="mz-tile-weigh"
                              data-testid="mz-tile-weigh">
                            <span class="mz-tile-weigh__i" t-esc="weighGlyph"/>
                            <span t-esc="byWeightLabel"/>
                        </span>
                        <!-- DESIGN v3: an 86'd dish is stamped ACROSS ITS PHOTO, not
                             pinned in a corner. The wash covers the media only, so the
                             name and price underneath stay readable — the cashier still
                             has to tell the guest which dish is off. -->
                        <span t-if="p.available === false" class="mz-tile-out">
                            <span class="mz-tile-out__stamp">86</span>
                        </span>
                    </span>
                    <span class="mz-tile__body">
                        <span class="mz-tile-name" t-esc="p.name"/>
                        <!-- DESIGN v3: the card is BILINGUAL — both names at once,
                             not one or the other by interface language. A menu is
                             read by whoever is standing at the counter. -->
                        <span t-if="p.name_ar" class="mz-tile-name-ar"
                              dir="rtl" data-testid="mz-tile-ar" t-esc="p.name_ar"/>
                        <!-- DESIGN v3: price, currency and the Options marker share ONE
                             baseline row, with a spacer between them — so the figure sits
                             on the leading edge and Options on the trailing one, however
                             long either happens to be. They used to be stacked blocks, and
                             the price reserved a fixed 34px of its own for the quick-add
                             corner; the row's spacer does that job now. -->
                        <span class="mz-tile-priceline">
                            <span t-if="currencyBefore" class="mz-tile-cur"
                                  t-esc="currencyLabel"/>
                            <span class="mz-tile-price" t-esc="priceAmount(p)"/>
                            <span t-if="!currencyBefore" class="mz-tile-cur"
                                  t-esc="currencyLabel"/>
                            <span class="mz-tile-priceline__gap"/>
                            <!-- DESIGN v3: a visible Options marker. Tapping the card
                                 already opens the configurator, but a configurable item
                                 that looks exactly like a plain one is one a cashier only
                                 discovers by accident.
                                 NOT the design's bordered BUTTON: that conversion is
                                 SCREEN01_DIFF row 39, which is held for a ruling. -->
                            <span t-if="hasOptions(p)" class="mz-tile-opts"
                                  data-testid="mz-tile-options">
                                <span class="mz-tile-opts__i" aria-hidden="true">⚙</span>
                                <span t-esc="optionsLabel"/>
                            </span>
                        </span>
                        <!-- Allergens under the item, where the design puts them:
                             a cashier who learns about sesame from the guest has
                             learnt it too late. -->
                        <span t-if="p.allergens.length" class="mz-tile-allerg"
                              data-testid="mz-tile-allergens">
                            <span class="mz-tile-allerg__i" aria-hidden="true">⚠</span>
                            <span t-esc="p.allergens.join(' · ')"/>
                        </span>
                    </span>
                    <!-- Corner badges, in the design's own order of loudness. -->
                    <span class="mz-tile-flags">
                        <span t-if="p.best_seller" class="mz-flag mz-flag--best"
                              data-testid="mz-flag-best" t-esc="bestSellerLabel"/>
                        <span t-if="p.is_combo" class="mz-flag mz-flag--combo"
                              t-esc="comboLabel"/>
                        <span t-if="p.portion" class="mz-flag mz-flag--portion"
                              data-testid="mz-flag-portion" t-esc="p.portion"/>
                        <span t-if="p.stock_left !== null" class="mz-flag mz-flag--low"
                              data-testid="mz-flag-low" t-esc="lowStockLabel(p)"/>
                    </span>
                    <span t-if="isFavorite(p)" class="mz-tile-star"
                          data-testid="mz-tile-star" aria-hidden="true">★</span>
                    <!-- the corner "86" pill moved onto the media as the design's
                         stamp (see .mz-tile-out above). `.mz-tile-badge` stays in
                         the stylesheet because static/drivethru.html still draws
                         its own card and still emits it. -->
                </button>
                <!-- Routes through select() — the SAME authoritative add path as the main
                     control, so it can never become a second way into the order.
                     KEYBOARD PARITY (operator decision): no tabindex attribute at all. A
                     native enabled <button> is already in the sequential focus order at
                     its DOM position, which gives main -> quick-add -> next main, and the
                     exact reverse under Shift+Tab. The extra stop per card is intentional;
                     an explicit tabindex (even "0") would only restate the default, and a
                     POSITIVE value would detach focus order from DOM order. A disabled
                     product's quick-add stays natively disabled, so it is skipped. -->
                <button type="button" class="mz-tile__quick-add"
                        t-att-disabled="p.available === false ? 'disabled' : false"
                        t-att-data-quick-add-id="p.id"
                        t-att-aria-label="addLabel(p)"
                        t-on-click="() => this.select(p)">
                    <span class="mz-tile__plus" aria-hidden="true">+</span>
                </button>
                <!-- Deliberately a visible button rather than core's press-and-hold. A
                     long-press is invisible: it is discoverable only by being told about
                     it, and on a busy till it collides with the drag a cashier makes when
                     they meant to tap. Its own control, with its own accessible name. -->
                <button t-if="props.onInfo" type="button" class="mz-tile__info"
                        t-att-data-info-id="p.id"
                        t-att-aria-label="infoLabel(p)"
                        t-att-title="infoLabel(p)"
                        t-on-click="() => props.onInfo(p)">i</button>
                <button t-if="props.onEightySix" type="button" class="mz-tile__86"
                        t-att-class="{ 'mz-tile__86--on': p.available === false }"
                        t-att-data-eightysix-id="p.id"
                        t-att-aria-pressed="p.available === false ? 'true' : 'false'"
                        t-att-aria-label="eightySixLabel(p)"
                        t-att-title="eightySixLabel(p)"
                        t-on-click="() => props.onEightySix(p, p.available === false)">86</button>
            </div>
        </div>
    </t>

</templates>
