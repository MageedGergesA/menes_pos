<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mezze_bridge.Cart">
        <aside class="mz-cart">
            <div class="mz-cart-head">
                <span>Current order</span>
                <span class="mz-cart-count" t-esc="order.count"/>
            </div>

            <div class="mz-cart-lines">
                <t t-if="!lines.length">
                    <div class="mz-cart-empty">Add items to start the order</div>
                </t>
                <!-- DESIGN FIDELITY: the reference line reads
                     [qty x] Name .................. line total
                             modifier / note
                     [- n +]            unit price each      [delete]
                     qty badge, note sub-line and unit price all come from the
                     EXISTING line model (qty, note, product.list_price) - no new
                     order data and no change to how a line is stored or merged. -->
                <div t-foreach="lines" t-as="line" t-key="line.key" class="mz-line">
                    <div class="mz-line-main">
                        <span t-if="line.qty > 1" class="mz-line-q" aria-hidden="true"
                              t-esc="line.qty + '×'"/>
                        <span class="mz-line-name" t-esc="line.product.name"/>
                        <span class="mz-line-total" t-esc="fmt(lineTotal(line))"/>
                    </div>
                    <p t-if="line.note" class="mz-line-note" t-esc="line.note"/>
                    <div class="mz-line-ctrls">
                        <span class="mz-stepper">
                            <button type="button" class="mz-stepper__btn"
                                    t-att-aria-label="'Decrease quantity of ' + line.product.name"
                                    t-on-click="() => this.dec(line)">−</button>
                            <span class="mz-stepper__value" t-esc="line.qty"/>
                            <button type="button" class="mz-stepper__btn"
                                    t-att-aria-label="'Increase quantity of ' + line.product.name"
                                    t-on-click="() => this.inc(line)">+</button>
                        </span>
                        <span t-if="line.qty > 1" class="mz-line-each"
                              t-esc="eachLabel(line)"/>
                        <button class="mz-line-remove" t-on-click="() => this.remove(line)"
                                title="Remove" aria-label="Remove line">✕</button>
                    </div>
                </div>
            </div>

            <div class="mz-cart-foot">
                <!-- The reference shows "Total  5 items  178.02". The item count is
                     real; the reference's Subtotal / Discount / VAT rows are NOT
                     reproduced because this dataset has no discount engine and no
                     product carries a tax - inventing those rows would be fake
                     money on a till. Documented in the restoration report. -->
                <div class="mz-total-row">
                    <span class="mz-total-k">Total</span>
                    <span t-if="order.count" class="mz-total-items" t-esc="itemsLabel"/>
                    <span class="mz-total-amt" t-esc="fmt(order.estimatedTotal)"/>
                </div>
                <button t-if="props.canAssign" class="mz-btn mz-btn--secondary mz-btn--send"
                        t-att-disabled="(!lines.length || props.inFlight) ? 'disabled' : false"
                        t-on-click="() => this.props.onAssign()">Assign table</button>
                <button t-if="props.canMove" class="mz-btn mz-btn--tertiary mz-btn--send"
                        t-att-disabled="props.inFlight ? 'disabled' : false"
                        t-on-click="() => this.props.onMove()">Move table</button>
                <button t-if="props.canPark" class="mz-btn mz-btn--tertiary mz-btn--send"
                        t-att-disabled="props.inFlight ? 'disabled' : false"
                        t-on-click="() => this.props.onPark()">Park order</button>
                <button t-if="props.canSend" class="mz-btn mz-btn--secondary mz-btn--send"
                        t-att-disabled="(!lines.length || props.inFlight) ? 'disabled' : false"
                        t-on-click="() => this.props.onSend()">Send to table</button>
                <button class="mz-btn mz-btn--charge"
                        title="Charge (Ctrl+Enter or F2)"
                        t-att-disabled="(!lines.length || props.inFlight) ? 'disabled' : false"
                        t-on-click="() => this.props.onCharge()"
                        t-esc="chargeLabel"/>
            </div>
        </aside>
    </t>

</templates>
