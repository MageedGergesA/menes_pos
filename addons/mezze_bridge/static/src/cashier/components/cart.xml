<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mezze_bridge.Cart">
        <aside class="mz-cart">
            <div class="mz-cart-head">
                <span t-esc="currentOrderLabel"/>
                <span class="mz-cart-count" t-esc="order.count"/>
            </div>

            <!-- PROTOTYPE: the order's CONTEXT sits at the top of the panel (table, cover
                 count, seat, customer) rather than in the topbar. Every row here is backed
                 by a real control that already exists — the prototype's service-mode
                 segmented control and its loyalty look-up are NOT reproduced because the
                 Register has no setter for either. -->
            <div t-if="props.tableLabel" class="mz-ctx mz-ctx--table">
                <div class="mz-ctx__main">
                    <span class="mz-ctx__t" t-esc="props.tableLabel"/>
                    <span class="mz-ctx__sub" t-esc="props.tableSubLabel"/>
                </div>
                <span class="mz-stepper mz-guest" role="group" t-att-aria-label="guestGroupLabel">
                    <button type="button" class="mz-stepper__btn" t-att-aria-label="fewerGuestsLabel"
                            t-att-disabled="(props.inFlight or props.guests &lt;= 1) ? 'disabled' : false"
                            t-on-click="() => this.props.onGuests(-1)">−</button>
                    <span class="mz-stepper__value" t-esc="props.guests"/>
                    <button type="button" class="mz-stepper__btn" t-att-aria-label="moreGuestsLabel"
                            t-att-disabled="props.inFlight ? 'disabled' : false"
                            t-on-click="() => this.props.onGuests(1)">+</button>
                </span>
            </div>
            <button t-if="props.onCustomer" type="button" class="mz-custchip"
                    t-att-disabled="props.inFlight ? 'disabled' : false"
                    t-on-click="() => this.props.onCustomer()">
                <span class="mz-custchip__ico" aria-hidden="true">☺</span>
                <span class="mz-custchip__t" t-esc="props.customerName or addCustomerLabel"/>
            </button>

            <div class="mz-cart-lines">
                <t t-if="!lines.length">
                    <div class="mz-cart-empty">Add items to start the order</div>
                </t>
                <!-- DESIGN FIDELITY: the reference line reads
                     [qty x] Name .................. line total
                             modifier / note
                     [- n +]            unit price each      [delete]
                     qty badge, note sub-line and unit price all come from the
                     EXISTING line model (qty, note, product.list_price) - no new
                     order data and no change to how a line is stored or merged. -->
                <div t-foreach="lines" t-as="line" t-key="line.key" class="mz-line">
                    <div class="mz-line-main">
                        <span t-if="line.qty > 1" class="mz-line-q" aria-hidden="true"
                              t-esc="line.qty + '×'"/>
                        <span class="mz-line-name" t-esc="line.product.name"/>
                        <span class="mz-line-total" t-esc="fmt(lineTotal(line))"/>
                    </div>
                    <p t-if="line.note" class="mz-line-note" t-esc="line.note"/>
                    <div class="mz-line-ctrls">
                        <span class="mz-stepper">
                            <button type="button" class="mz-stepper__btn"
                                    t-att-aria-label="'Decrease quantity of ' + line.product.name"
                                    t-on-click="() => this.dec(line)">−</button>
                            <span class="mz-stepper__value" t-esc="line.qty"/>
                            <button type="button" class="mz-stepper__btn"
                                    t-att-aria-label="'Increase quantity of ' + line.product.name"
                                    t-on-click="() => this.inc(line)">+</button>
                        </span>
                        <span t-if="line.qty > 1" class="mz-line-each"
                              t-esc="eachLabel(line)"/>
                        <button class="mz-line-remove" t-on-click="() => this.remove(line)"
                                title="Remove" aria-label="Remove line">✕</button>
                    </div>
                </div>
            </div>

            <div class="mz-cart-foot">
                <!-- PROTOTYPE ACTION GRID — 3 columns of 101x52 verbs. The prototype shows
                     Discount / Note / Customer / Split / Park / Gift card / Refund; of those
                     only Customer and Park have anything behind them in this product, so the
                     GRID is adopted and filled with the verbs that actually work, including
                     three the prototype never had (Assign, Move, Send). A till must not offer
                     a button that does nothing. -->
                <div t-if="verbs.length" class="mz-verbs">
                    <button t-foreach="verbs" t-as="v" t-key="v.key"
                            type="button" class="mz-verb"
                            t-att-class="{ 'mz-verb--danger': v.danger }"
                            t-att-disabled="v.disabled ? 'disabled' : false"
                            t-on-click="() => v.run()">
                        <span class="mz-verb__ico" aria-hidden="true" t-esc="v.glyph"/>
                        <span class="mz-verb__t" t-esc="v.label"/>
                    </button>
                </div>

                <!-- Totals. Subtotal / Service / VAT appear ONLY when the order actually
                     carries them; nothing here is invented, so on a tax-free catalogue the
                     panel shows a single honest Total. -->
                <div t-if="hasBreakdown" class="mz-trow">
                    <span class="mz-trow__k" t-esc="subtotalLabel"/>
                    <span class="mz-trow__v" t-esc="fmt(order.subtotal)"/>
                </div>
                <div class="mz-total-row">
                    <span class="mz-total-k" t-esc="totalLabel"/>
                    <span t-if="order.count" class="mz-total-items" t-esc="itemsLabel"/>
                    <span class="mz-total-amt" t-esc="fmt(order.estimatedTotal)"/>
                </div>
                <button class="mz-btn mz-btn--charge"
                        t-att-title="chargeTitle"
                        t-att-disabled="(!lines.length || props.inFlight) ? 'disabled' : false"
                        t-on-click="() => this.props.onCharge()"
                        t-esc="chargeLabel"/>
            </div>
        </aside>
    </t>

</templates>
