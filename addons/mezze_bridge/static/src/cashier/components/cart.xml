<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mezze_bridge.Cart">
        <aside class="mz-cart">
            <!-- DESIGN v3 header: what this check IS, then what it is made of, then
                 its identity and age. "Current order" told the cashier nothing they
                 could not already see. -->
            <div class="mz-cart-head">
                <span class="mz-cart-head__t" data-testid="mz-order-title"
                      t-esc="props.orderTitle or currentOrderLabel"/>
                <span class="mz-cart-count mz-cart-head__c" data-testid="mz-order-counts"
                      t-esc="props.orderCountsLine"/>
            </div>
            <p t-if="props.orderMetaLine" class="mz-cart-meta"
               data-testid="mz-order-meta" t-esc="props.orderMetaLine"/>

            <!-- SCREEN01_DIFF rows 67-71: another terminal moved this check. Named,
                 not silently redrawn — the quantities being replaced are somebody's
                 work, and Charge stays shut until it is settled one way or the other.
                 It lives HERE, under the panel head and above the lines it is talking
                 about, because that is where the design puts it and because out in
                 the workspace it was a third flex column stealing width from both
                 the catalogue and this panel. -->
            <div t-if="props.conflict" class="mz-conflict" role="alert" aria-live="assertive">
                <div class="mz-conflict__row0">
                    <span class="mz-conflict__i" aria-hidden="true" t-esc="conflictGlyph"/>
                    <div class="mz-conflict__head">
                        <span class="mz-conflict__t" t-esc="props.conflictTitle"/>
                        <span class="mz-conflict__b" t-esc="props.conflict.headline"/>
                    </div>
                </div>
                <div t-if="props.conflictReview and props.conflict.diffs.length"
                     class="mz-conflict__rows">
                    <div t-foreach="props.conflict.diffs" t-as="d" t-key="d.product_id"
                         class="mz-conflict__row">
                        <span class="mz-conflict__n" t-esc="d.name"/>
                        <span class="mz-conflict__q">
                            <t t-esc="d.mine"/> · <t t-esc="d.theirs"/>
                        </span>
                    </div>
                </div>
                <!-- SCREEN01_DIFF row 71: three QUIET buttons. Keep mine wore the
                     primary fill, which recommended one side of a disagreement the
                     till has no basis to have an opinion about. -->
                <div class="mz-conflict__acts">
                    <button class="mz-conflict__a" type="button"
                            t-on-click="() => props.onKeepMine()" t-esc="keepMineLabel"/>
                    <button class="mz-conflict__a" type="button"
                            t-on-click="() => props.onKeepTheirs()" t-esc="keepTheirsLabel"/>
                    <button class="mz-conflict__a mz-conflict__a--review" type="button"
                            t-att-aria-expanded="props.conflictReview ? 'true' : 'false'"
                            t-on-click="() => props.onConflictReview()" t-esc="reviewLabel"/>
                </div>
            </div>

            <!-- Order class, as in the reference. Dine-in/Takeaway are one order with
                 a different service mode; Delivery opens its own form because it needs
                 an address, a zone and a branch-decided fee. -->
            <div t-if="props.orderTypes" class="mz-otype" role="group"
                 aria-label="Order type" data-testid="mz-order-type">
                <button t-foreach="props.orderTypes" t-as="t" t-key="t.key"
                        type="button" class="mz-otype__b"
                        t-att-class="{ 'mz-otype__b--on': t.active }"
                        t-att-aria-pressed="t.active ? 'true' : 'false'"
                        t-att-data-otype="t.key"
                        t-att-disabled="(props.inFlight or t.disabled) ? 'disabled' : false"
                        t-att-title="t.reason"
                        t-att-aria-describedby="t.reason ? 'mz-otype-why' : false"
                        t-on-click="() => props.onOrderType(t.key)" t-esc="t.label"/>
            </div>
            <!-- OUTSIDE the button group: .mz-otype is a flex row, so a paragraph
                 inside it competes with the three chips for the same width and
                 squeezes them down to single letters. Stated once, below the row,
                 as real text — a title attribute alone is invisible to touch, which
                 is how this till is actually used. -->
            <p t-if="disabledReason" id="mz-otype-why" class="mz-otype__why"
               t-esc="disabledReason"/>

            <!-- PROTOTYPE: the order's CONTEXT sits at the top of the panel (table, cover
                 count, seat, customer) rather than in the topbar. Every row here is backed
                 by a real control that already exists — the prototype's service-mode
                 segmented control and its loyalty look-up are NOT reproduced because the
                 Register has no setter for either. -->
            <div t-if="props.tableLabel" class="mz-ctx mz-ctx--table">
                <div class="mz-ctx__main">
                    <span class="mz-ctx__t" t-esc="props.tableLabel"/>
                    <span class="mz-ctx__sub" t-esc="props.tableSubLabel"/>
                </div>
                <span class="mz-stepper mz-guest" role="group" t-att-aria-label="guestGroupLabel">
                    <button type="button" class="mz-stepper__btn" t-att-aria-label="fewerGuestsLabel"
                            t-att-disabled="(props.inFlight or props.guests &lt;= 1) ? 'disabled' : false"
                            t-on-click="() => this.props.onGuests(-1)">−</button>
                    <span class="mz-stepper__value" t-esc="props.guests"/>
                    <button type="button" class="mz-stepper__btn" t-att-aria-label="moreGuestsLabel"
                            t-att-disabled="props.inFlight ? 'disabled' : false"
                            t-on-click="() => this.props.onGuests(1)">+</button>
                </span>
            </div>
            <div t-if="props.onCustomer" class="mz-custchip-cell">
                <button type="button" class="mz-custchip"
                        t-att-class="{ 'mz-custchip--on': props.customerName }"
                        t-att-disabled="props.inFlight ? 'disabled' : false"
                        t-on-click="() => this.props.onCustomer()">
                    <span class="mz-custchip__ico mz-verb__ico" aria-hidden="true" t-esc="customerGlyph"/>
                    <span class="mz-custchip__t" t-esc="props.customerName or addCustomerLabel"/>
                </button>
                <!-- SCREEN01_DIFF row 74: take the guest off the check without
                     opening the picker to do it. -->
                <button t-if="props.customerName and props.onClearCustomer" type="button"
                        class="mz-custchip__x" data-testid="mz-customer-clear"
                        t-att-aria-label="removeGuestLabel" t-att-title="removeGuestLabel"
                        t-att-disabled="props.inFlight ? 'disabled' : false"
                        t-on-click="() => props.onClearCustomer()"
                        t-esc="removeGuestGlyph"/>
            </div>

            <!-- DESIGN v3: a check the server will no longer accept edits for is
                 shown LOCKED, with the reason, rather than silently swallowing the
                 cashier's changes. The prototype locks the selected line; our
                 refusal is order-wide (the server declines the whole cart, not one
                 row), so the notice belongs to the check. -->
            <div t-if="props.editLocked" class="mz-lock" role="status"
                 data-testid="mz-edit-lock">
                <span class="mz-lock__ico" aria-hidden="true">🔒</span>
                <span class="mz-lock__t" t-esc="props.editLockMessage"/>
            </div>

            <div class="mz-cart-lines" t-att-class="{ 'mz-cart-lines--locked': props.editLocked }">
                <!-- SCREEN01_DIFF row 78: the design's empty check is a dashed CARD
                     with a mark, a title and a line telling the cashier what to do —
                     not one grey sentence. An empty panel is the first thing a new
                     starter sees on every order, so it is the cheapest place in the
                     product to say how the screen works. -->
                <t t-if="!lines.length">
                    <div class="mz-cart-empty" data-testid="mz-cart-empty">
                        <span class="mz-cart-empty__i" aria-hidden="true" t-esc="emptyGlyph"/>
                        <span class="mz-cart-empty__t" t-esc="emptyTitle"/>
                        <span class="mz-cart-empty__b" t-esc="emptyBody"/>
                    </div>
                </t>
                <!-- DESIGN FIDELITY: the reference line reads
                     [qty x] Name .................. line total
                             modifier / note
                     [- n +]            unit price each      [delete]
                     qty badge, note sub-line and unit price all come from the
                     EXISTING line model (qty, note, product.list_price) - no new
                     order data and no change to how a line is stored or merged. -->
                <div t-foreach="lines" t-as="line" t-key="line.key" class="mz-line"
                     t-att-class="{ 'mz-line--comped': isComped(line),
                                    'mz-line--sel': isLineSelected(line) }"
                     t-att-data-line="line.key"
                     t-att-data-selected="isLineSelected(line) ? 'true' : 'false'">
                    <!-- The whole row is the affordance: on a touch till the target
                         for "act on this line" should be the line, not a handle. -->
                    <div class="mz-line-main" role="button" tabindex="0"
                         t-att-aria-expanded="isLineSelected(line) ? 'true' : 'false'"
                         t-att-aria-label="line.product.name"
                         t-on-click="() => this.selectLine(line)"
                         t-on-keydown="(ev) => this.onLineKey(ev, line)">
                        <span t-if="line.qty > 1" class="mz-line-q" aria-hidden="true"
                              t-esc="line.qty + '×'"/>
                        <span class="mz-line-name" t-esc="line.product.name"/>
                        <!-- The unit price sits with the NAME, not with the controls.
                             It is the one item in that row that is not a touch target,
                             and while it lived there the row's minimum width exceeded
                             the panel's own 340px basis. A flex item cannot shrink past
                             its content, so the whole order panel grew by 22px the
                             moment a line was added — which resized every product card
                             and reflowed the grid under the cashier's finger. -->
                        <span t-if="line.qty > 1" class="mz-line-each"
                              t-esc="eachLabel(line)"/>
                        <span t-if="isComped(line)" class="mz-line-tag" t-esc="compedLabel"/>
                        <span t-if="isMerged(line)" class="mz-line-tag mz-line-tag--merged"
                              data-testid="mz-line-merged"
                              t-att-title="line.merged_from" t-esc="mergedLabel"/>
                        <span t-if="kitchenLabel(line)" class="mz-line-tag mz-line-tag--kds"
                              t-att-class="'mz-line-tag--' + line.kitchen_state"
                              data-testid="mz-line-kitchen" t-esc="kitchenLabel(line)"/>
                        <span class="mz-line-total" t-esc="fmt(lineTotal(line))"/>
                        <!-- Removing a line belongs with the line's identity, not among
                             the quantity controls. It also keeps that row inside the
                             panel width on a configurable line, where the extra Edit
                             button would otherwise push the remove button onto a
                             second row and make every such line twice as tall. -->
                        <!-- No delete on the row: the design has none. Taking an item
                             off a check is the same class of act as comping it, and it
                             now lives in the line's overflow as "Void line". -->
                    </div>
                    <!-- CONV-3: the chosen options, on the line that carries them.
                         Separate from the free-text note: one is a structured choice
                         the kitchen and the price both know about, the other is an
                         instruction. -->
                    <p t-if="line.modifiers and line.modifiers.length" class="mz-line-note"
                       t-esc="line.modifiers.join(' · ')"/>
                    <!-- SCREEN01_DIFF row 97: a typed instruction is its own row in
                         the accent ink with an `edit_note` mark. It used to share a
                         class with the modifier line above, so "no onion" (a priced
                         choice) and "allergic — check with chef" (a sentence someone
                         must read) looked identical. -->
                    <p t-if="line.note" class="mz-line-typed">
                        <span class="mz-line-typed__i" aria-hidden="true" t-esc="typedNoteGlyph"/>
                        <span t-esc="line.note"/>
                    </p>
                    <div t-if="isLineSelected(line)" class="mz-line-ctrls">
                        <!-- A weight is not stepped. "+" on 0.4 kg of cheese means a
                             whole extra kilogram, which is not what a cashier reaching
                             for a plus sign is asking for — so a weighed line shows what
                             it weighs and is changed on the pad, where the number is
                             typed and read back before it is charged. -->
                        <span t-if="isWeighed(line)" class="mz-line-weight"
                              data-testid="mz-line-weight"
                              t-att-data-qty="line.qty" t-esc="weightText(line)"/>
                        <span t-else="" class="mz-stepper">
                            <button type="button" class="mz-stepper__btn"
                                    t-att-aria-label="'Decrease quantity of ' + line.product.name"
                                    t-on-click="() => this.dec(line)">−</button>
                            <span class="mz-stepper__value" t-esc="line.qty"/>
                            <button type="button" class="mz-stepper__btn"
                                    t-att-aria-label="'Increase quantity of ' + line.product.name"
                                    t-on-click="() => this.inc(line)">+</button>
                        </span>
                        <!-- Correcting a choice must not mean deleting the line and
                             starting again. Offered only where there is something to
                             correct. -->
                        <button t-if="props.onConfigure and canConfigure(line)" type="button"
                                class="mz-line-edit" data-testid="mz-line-edit"
                                t-att-aria-label="editLabel + ': ' + line.product.name"
                                t-on-click="() => props.onConfigure(line)" t-esc="editLabel"/>
                        <!-- Open the pad ON THIS LINE. A pad that acts on "the last
                             thing added" eventually reprices the wrong dish. -->
                        <!-- Which batch this line came from. Offered only where the
                             product is actually tracked; a lot on anything else is
                             fiction in the audit trail. -->
                        <!-- DESIGN v3: Note stays on the row; Discount, Comp,
                             Assign seat, Type quantity and Lot move behind `⋯`.
                             Seven controls in a 436px column wrapped the row and
                             gave comping an item the same weight as the stepper. -->
                        <button t-if="props.onNote" type="button"
                                class="mz-line-note-btn" data-testid="mz-line-note"
                                t-att-title="noteLabel"
                                t-att-aria-label="noteLabel + ': ' + line.product.name"
                                t-on-click="() => props.onNote(line)" t-esc="noteLabel"/>
                        <button t-if="lineMenuItems(line).length" type="button"
                                class="mz-line-more" data-testid="mz-line-more"
                                t-att-data-more="line.key"
                                t-att-class="{ 'mz-line-more--on': lineMenuOpen(line) }"
                                t-att-aria-expanded="lineMenuOpen(line) ? 'true' : 'false'"
                                t-att-aria-label="lineMoreLabel + ': ' + line.product.name"
                                t-on-click="() => this.toggleLineMenu(line)">
                            <span class="mz-verb__ico" aria-hidden="true" t-esc="moreGlyph"/>
                        </button>
                    </div>
                    <!-- The design expands the menu INLINE beneath the line rather
                         than floating it: on a touch till a popover over the next
                         line is a mis-tap waiting to happen, and it hides the very
                         row the cashier is acting on. -->
                    <div t-if="lineMenuItems(line).length" class="mz-linemenu"
                         t-att-hidden="lineMenuOpen(line) ? false : 'hidden'"
                         data-testid="mz-line-menu" role="group"
                         t-att-aria-label="lineMoreLabel">
                        <button t-foreach="lineMenuItems(line)" t-as="a" t-key="a.key"
                                type="button"
                                t-att-class="'mz-linemenu__b ' + lineActTestId(a.key)
                                             + (a.danger ? ' mz-linemenu__b--danger' : '')"
                                t-att-data-line-act="a.key"
                                t-att-data-testid="lineActTestId(a.key)"
                                t-att-disabled="a.disabled ? 'disabled' : false"
                                t-on-click="() => { a.run(); this.state.lineMenu = null; }">
                            <span class="mz-verb__ico" aria-hidden="true" t-esc="a.glyph"/>
                            <span class="mz-linemenu__t" t-esc="a.label"/>
                            <!-- The design marks a row that will ask for a manager,
                                 so the cashier knows before they tap, not after. -->
                            <span t-if="a.gated" class="mz-verb__ico mz-linemenu__lock"
                                  aria-hidden="true" t-esc="gatedGlyph"/>
                        </button>
                    </div>
                </div>
            </div>

            <div class="mz-cart-foot">
                <!-- PROTOTYPE ACTION GRID — 3 columns of 101x52 verbs. The prototype shows
                     Discount / Note / Customer / Split / Park / Gift card / Refund; of those
                     only Customer and Park have anything behind them in this product, so the
                     GRID is adopted and filled with the verbs that actually work, including
                     three the prototype never had (Assign, Move, Send). A till must not offer
                     a button that does nothing. -->
                <!-- The order type, when the branch uses presets. Shown above the
                     cart because it can change what everything costs. -->
                <div t-if="props.presets and props.presets.length" class="mz-presets"
                     role="group" aria-label="Order type" data-testid="mz-presets">
                    <button t-foreach="props.presets" t-as="p" t-key="p.id"
                            type="button" class="mz-tab"
                            t-att-class="{'mz-tab--active': props.presetId === p.id}"
                            t-att-aria-pressed="(props.presetId === p.id) ? 'true' : 'false'"
                            t-att-data-preset="p.id"
                            t-att-disabled="props.inFlight ? 'disabled' : false"
                            t-on-click="() => props.onPreset(p.id)" t-esc="p.name"/>
                </div>

                <!-- What else this guest might want. From real baskets, with the
                     reason shown — an unexplained suggestion is one a cashier will
                     not repeat out loud to a guest. -->
                <!-- SCREEN01_DIFF row 82: the design's reading order in this foot is
                     NOTE -> UPSELL -> TOTALS -> CHARGE -> the four verbs. Ours ran the
                     verbs and the note before the money, so the panel asked the cashier
                     to read past two rows of controls to reach the figure the guest is
                     about to be asked for. Moved in the MARKUP rather than with CSS
                     `order`, so the tab sequence and what a screen reader announces
                     match what is on the screen. -->
                <div t-if="lines.length" class="mz-onote" data-testid="mz-order-note">
                    <span class="mz-verb__ico mz-onote__ico" aria-hidden="true"
                          t-esc="noteGlyph"/>
                    <input type="text" class="mz-onote__i"
                           t-att-placeholder="props.orderNoteLabel"
                           t-att-value="props.orderNote"
                           t-att-disabled="props.editLocked ? 'disabled' : false"
                           t-on-input="(ev) => props.onOrderNote(ev.target.value)"/>
                    <span class="mz-onote__n" t-esc="props.orderNoteCount"/>
                </div>

                <!-- DESIGN v3: the money is ONE bounded card, not a run of rows
                     sharing the footer with the note and the verbs above it. The
                     border is what says "this is the bill" — the figures the guest
                     is about to be asked for are grouped, and the Charge button sits
                     outside it as the act rather than part of the statement. -->
                <div t-if="props.upsell and props.upsell.length" class="mz-upsell"
                     data-testid="mz-upsell" aria-label="Suggestions">
                    <button t-foreach="props.upsell" t-as="s" t-key="s.product_id"
                            type="button" class="mz-upsell__chip"
                            t-att-data-upsell="s.product_id"
                            t-att-disabled="props.inFlight ? 'disabled' : false"
                            t-on-click="() => props.onUpsell(s)">
                        <span class="mz-upsell__n" t-esc="s.name"/>
                        <span class="mz-upsell__w" t-esc="props.upsellReason(s)"/>
                    </button>
                </div>

                <!-- DESIGN v3 footer: the three verbs a cashier reaches for on every
                     check sit ON the panel; the other thirteen live behind More,
                     under the design's own four headings. A flat grid of sixteen
                     said that voiding an order and opening the drawer are the same
                     kind of decision. -->
                <div class="mz-totals" data-testid="mz-totals">
                <!-- Totals. Subtotal / Service / VAT appear ONLY when the order actually
                     carries them; nothing here is invented, so on a tax-free catalogue the
                     panel shows a single honest Total. -->
                <div t-if="hasBreakdown" class="mz-trow"
                     t-att-hidden="state.sumOpen ? false : 'hidden'">
                    <span class="mz-trow__k">
                        <t t-esc="subtotalLabel"/>
                        <!-- The design puts the item count HERE, beside what the food
                             came to — not on the Total, where it sat competing with
                             the figure the guest is asked for. -->
                        <span t-if="order.count" class="mz-trow__n" t-esc="itemsLabel"/>
                    </span>
                    <span class="mz-trow__v" t-esc="fmt(order.subtotal)"/>
                </div>
                <!-- The branch's service charge, named with its rate as the design
                     names it. Shown only where one is actually levied. -->
                <div t-if="serviceCharge" class="mz-trow" data-testid="mz-service-row"
                     t-att-hidden="state.sumOpen ? false : 'hidden'">
                    <span class="mz-trow__k" t-esc="serviceLabel"/>
                    <span class="mz-trow__v" t-esc="fmt(serviceCharge)"/>
                </div>
                <!-- One row per tax, named as the branch's own account.tax names it.
                     A bill that shows a total and never says how much of it is tax
                     is not a bill anyone can check. -->
                <div t-foreach="taxRows" t-as="tx" t-key="tx.key"
                     class="mz-trow" data-testid="mz-tax-row"
                     t-att-hidden="state.sumOpen ? false : 'hidden'">
                    <span class="mz-trow__k" t-esc="tx.label"/>
                    <span class="mz-trow__v" t-esc="fmt(tx.amount)"/>
                </div>
                <!-- DESIGN v3: the breakdown folds away. The rows are hidden with
                     [hidden] rather than dropped from the template, so the control's
                     aria-expanded and what is on screen can never disagree. -->
                <button t-if="hasSumToggle" type="button" class="mz-sumtog"
                        data-testid="mz-sum-toggle"
                        t-att-aria-expanded="state.sumOpen ? 'true' : 'false'"
                        t-on-click="() => this.toggleSummary()">
                    <span class="mz-verb__ico" aria-hidden="true" t-esc="sumToggleGlyph"/>
                    <span t-esc="sumToggleLabel"/>
                </button>
                <div class="mz-total-row">
                    <span class="mz-total-k" t-esc="totalLabel"/>
                    <!-- SCREEN01_DIFF row 118: figure and currency as two elements. -->
                    <span t-if="currencyBefore" class="mz-total-cur" t-esc="currencyLabel"/>
                    <span class="mz-total-amt" t-esc="amountOnly(order.grandTotal)"/>
                    <span t-if="!currencyBefore" class="mz-total-cur" t-esc="currencyLabel"/>
                </div>
                </div>
                <!-- The design's Charge carries a `payments` glyph beside its label. -->
                <button class="mz-btn mz-btn--charge" data-testid="mz-charge"
                        t-att-title="chargeTitle"
                        t-att-disabled="(!lines.length || props.inFlight || props.conflicted) ? 'disabled' : false"
                        t-on-click="() => this.props.onCharge()">
                    <span class="mz-verb__ico mz-btn--charge__ico" aria-hidden="true"
                          t-esc="chargeGlyph"/>
                    <span t-esc="chargeLabel"/>
                    <!-- SCREEN01_DIFF row 125: figure and currency beside the label. -->
                    <t t-if="chargeReady">
                        <span t-if="currencyBefore" class="mz-btn--charge__cur"
                              t-esc="currencyLabel"/>
                        <span class="mz-btn--charge__amt"
                              t-esc="amountOnly(order.grandTotal)"/>
                        <span t-if="!currencyBefore" class="mz-btn--charge__cur"
                              t-esc="currencyLabel"/>
                    </t>
                </button>
                <div t-if="sheetGroups.length" class="mz-sheet"
                     t-att-hidden="state.sheet ? false : 'hidden'"
                     data-testid="mz-more-sheet" role="group"
                     t-att-aria-label="moreLabel">
                    <section t-foreach="sheetGroups" t-as="g" t-key="g.key"
                             class="mz-sheet__g" t-att-data-group="g.key">
                        <h3 class="mz-sheet__t" t-esc="g.title"/>
                        <div class="mz-sheet__i">
                            <button t-foreach="g.items" t-as="v" t-key="v.key"
                                    type="button" class="mz-verb"
                                    t-att-class="{ 'mz-verb--danger': g.danger }"
                                    t-att-data-verb="v.key"
                                    t-att-disabled="v.disabled ? 'disabled' : false"
                                    t-on-click="() => v.run()">
                                <span class="mz-verb__ico" aria-hidden="true" t-esc="v.glyph"/>
                                <span class="mz-verb__t" t-esc="v.label"/>
                            </button>
                        </div>
                    </section>
                </div>
                <div t-if="primaryActions.length or sheetGroups.length"
                     class="mz-foot" data-testid="mz-panel-footer">
                    <button t-foreach="primaryActions" t-as="v" t-key="v.key"
                            type="button" class="mz-verb mz-foot__b"
                            t-att-data-verb="v.key"
                            t-att-disabled="v.disabled ? 'disabled' : false"
                            t-on-click="() => v.run()">
                        <span class="mz-verb__ico" aria-hidden="true" t-esc="v.glyph"/>
                        <span class="mz-verb__t" t-esc="v.label"/>
                    </button>
                    <button t-if="sheetGroups.length" type="button"
                            class="mz-verb mz-foot__b mz-foot__more"
                            t-att-class="{ 'mz-foot__more--on': state.sheet }"
                            data-testid="mz-more"
                            t-att-aria-expanded="state.sheet ? 'true' : 'false'"
                            t-on-click="() => this.toggleSheet()">
                        <span class="mz-verb__ico" aria-hidden="true" t-esc="moreGlyph"/>
                        <span class="mz-verb__t" t-esc="moreLabel"/>
                    </button>
                </div>

                <!-- One tap for a whole order, for the methods the branch marked as
                     fast. Beside Charge rather than instead of it: a mixed or partial
                     tender still needs the payment screen.
                     SCREEN01_DIFF row 90: hidden in CSS, kept in the markup so
                     reinstating it is one rule. -->
                <div t-if="props.fastMethods and props.fastMethods.length"
                     class="mz-fastpay" data-testid="mz-fastpay">
                    <button t-foreach="props.fastMethods" t-as="m" t-key="m.id"
                            type="button" class="mz-btn mz-btn--secondary mz-fastpay__b"
                            t-att-data-fastpay="m.id"
                            t-att-disabled="(!lines.length || props.inFlight || props.conflicted) ? 'disabled' : false"
                            t-on-click="() => props.onFastPay(m)"
                            t-esc="m.name"/>
                </div>
            </div>
        </aside>
    </t>

</templates>
