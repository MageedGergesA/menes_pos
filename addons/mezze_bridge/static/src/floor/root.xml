<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mezze_bridge.FloorRoot">
        <div class="mz-app mz-floor" t-att-data-phase="state.phase">            <header class="mz-topbar">
                <div class="mz-brand">
                    <span class="mz-logo">Mezze</span>
                    <span class="mz-branch" t-esc="branchName"/>
                </div>
                <!-- (workspace navigation lives in the rail) -->
                <div class="mz-topbar-right">
                    <span t-attf-class="mz-status mz-status--sm mz-status--{{connVariant}}"
                          t-att-data-state="state.conn" t-att-title="connLabel">
                        <span class="mz-status__dot"/><t t-esc="connLabel"/>
                    </span>
                    <span class="mz-user" t-esc="userName"/>
                </div>
            </header>

            <!-- The rail is the shell, so Floor carries it too: walking here from the
                 Register used to throw the navigation away and strand the operator. -->
            <div class="mz-appbody">
            <WorkspaceRail active="'floor'" configId="configId" mark="railMark"
                           userName="userName"/>

            <div class="mz-shell">

            <!-- Top bar — SAME shell language as the Register (brand · branch ·
                 connectivity · user). The horizontal nav is gone: the rail owns
                 navigation now, and two navigations would be one too many. -->


            <!-- BOOTING -->
            <t t-if="state.phase === 'booting'">
                <div class="mz-state mz-state--info" role="status" aria-busy="true"><div class="mz-spinner" aria-hidden="true"/><p>Loading floor…</p></div>
            </t>

            <!-- AUTH REQUIRED -->
            <t t-elif="state.phase === 'auth_required'">
                <div class="mz-state mz-state--warn">
                    <h2>Authentication required</h2>
                    <p>Your session has expired. Please sign in again to continue.</p>
                    <a class="mz-btn mz-btn--primary" href="/web/login?redirect=/mezze/floor">Sign in</a>
                </div>
            </t>

            <!-- ERROR -->
            <t t-elif="state.phase === 'error'">
                <div class="mz-state mz-state--error">
                    <h2>Unable to continue</h2>
                    <p t-esc="state.errorMsg || 'Unable to load the floor'"/>
                    <button class="mz-btn mz-btn--primary" t-on-click="() => this.retry()">Retry</button>
                </div>
            </t>

            <!-- READY -->
            <t t-elif="state.phase === 'ready'">
                <section class="mz-floorspace">

                    <!-- DESIGN 02 TOOLBAR: zone tabs (each carrying how many of its
                         tables are free), then the live service stats. Choosing which
                         room to walk to is the decision this strip supports, so the
                         free count belongs ON the tab rather than a click away. -->
                    <div class="mz-floorbar">
                        <span class="mz-floorbar__t">
                            <span class="mz-verb__ico" aria-hidden="true" t-esc="floorGlyph"/>
                            <span t-esc="floorTitle"/>
                        </span>
                        <nav class="mz-floortabs" t-att-aria-label="zonesLabel">
                            <button t-foreach="floors" t-as="fl" t-key="fl.id"
                                    class="mz-floortab"
                                    t-att-class="{'mz-floortab--active': fl.id === (activeFloor and activeFloor.id)}"
                                    t-att-aria-current="fl.id === (activeFloor and activeFloor.id) ? 'page' : undefined"
                                    t-att-data-zone="fl.id"
                                    t-on-click="() => this.onSelectFloor(fl.id)">
                                <span t-esc="fl.name"/>
                                <span class="mz-floortab__n mz-num" t-esc="freeCount(fl.id)"/>
                            </button>
                        </nav>
                        <div class="mz-floorstats" aria-label="Service summary">
                            <span class="mz-stat"><span class="mz-stat__v mz-num"><t t-esc="stats.occupied"/>/<t t-esc="stats.total"/></span><span class="mz-stat__k">Occupied</span></span>
                            <span class="mz-stat"><span class="mz-stat__v mz-num" t-esc="stats.covers"/><span class="mz-stat__k">Covers</span></span>
                            <span class="mz-stat"><span class="mz-stat__v mz-num" t-esc="elapsed(stats.avgDwell)"/><span class="mz-stat__k">Avg dwell</span></span>
                            <span class="mz-stat"><span class="mz-stat__v mz-num" t-esc="fmt(stats.onFloor)"/><span class="mz-stat__k">On floor</span></span>
                        </div>
                    </div>

                    <!-- BODY: canvas panel + a fixed 320px side panel, as the design
                         lays it out. -->
                    <div class="mz-floorbody">

                        <div class="mz-canvaspanel">
                            <!-- Legend — every state is text + shape, never colour
                                 alone — and it COUNTS. A legend that only names the
                                 colours says what the map means; one that counts them
                                 says what the room is doing. -->
                            <div class="mz-legend" aria-label="Table states">
                                <span t-foreach="legend" t-as="l" t-key="l.key"
                                      class="mz-legend__item" t-att-data-legend="l.key">
                                    <span t-attf-class="mz-swatch mz-swatch--{{l.key}}"/>
                                    <span t-esc="l.label"/>
                                    <span class="mz-legend__n mz-num" t-esc="l.count"/>
                                </span>
                                <span class="mz-legend__hint" t-esc="canvasHint"/>
                            </div>

                            <div class="mz-canvas-wrap"
                                 t-att-class="{ 'mz-canvas-wrap--panning': state.panning }"
                                 data-testid="mz-floor-canvas"
                                 t-on-pointerdown="(ev) => this.onCanvasDown(ev)"
                                 t-on-pointermove="(ev) => this.onCanvasMove(ev)"
                                 t-on-pointerup="() => this.onCanvasUp()"
                                 t-on-pointerleave="() => this.onCanvasUp()">
                                <t t-if="!tables.length">
                                    <div class="mz-canvas-empty" t-esc="noTablesHint"/>
                                </t>
                                <div t-else="" class="mz-canvas" t-att-style="canvasTransform">
                                    <t t-foreach="tables" t-as="t" t-key="t.id">
                                        <button class="mz-tbl"
                                                t-att-class="'mz-tbl--' + stateMeta(t.status).fill + ' mz-tbl--' + t.status + (t.id === state.selectedTableId ? ' mz-tbl--sel' : '')"
                                                t-att-style="tableStyle(t)"
                                                t-att-data-table-id="t.id"
                                                t-att-aria-label="'Table ' + t.name + ' — ' + stateMeta(t.status).label + ', ' + seatRatio(t) + ' seats' + (t.minutes ? (', ' + elapsed(t.minutes)) : '')"
                                                t-on-click="() => this.onTapTable(t)">
                                            <!-- seat marks around the perimeter -->
                                            <span class="mz-seats" aria-hidden="true">
                                                <span t-foreach="seatDots(t)" t-as="s" t-key="s"
                                                      class="mz-seat" t-att-style="seatDotStyle(t, s, seatDots(t).length)"/>
                                            </span>
                                            <!-- the wood top the info card sits on -->
                                            <span class="mz-tbl__top" aria-hidden="true"/>
                                            <!-- DESIGN 02: a centred info card, not a
                                                 loose meta line. Number, then the seat
                                                 RATIO — a host scanning for somewhere
                                                 to put a party of three is comparing
                                                 exactly that. -->
                                            <span class="mz-tbl__card">
                                                <span class="mz-tbl__num mz-num" t-esc="t.name"/>
                                                <span class="mz-tbl__ratio mz-num"
                                                      data-testid="mz-table-ratio" t-esc="seatRatio(t)"/>
                                                <span t-if="statusStrip(t)" class="mz-tbl__strip"
                                                      data-testid="mz-table-strip" t-esc="statusStrip(t)"/>
                                                <span t-if="t.server or t.total" class="mz-tbl__foot">
                                                    <span t-if="t.server" class="mz-tbl__srv"
                                                          t-att-title="t.server" t-esc="serverInitials(t)"/>
                                                    <span t-if="t.total" class="mz-tbl__spend mz-num"
                                                          t-esc="fmt(t.total)"/>
                                                </span>
                                            </span>
                                        </button>
                                    </t>
                                </div>
                            </div>

                            <!-- Zoom bar. The readout doubles as zoom-to-fit, which
                                 also recentres — a fit that left the plan panned off
                                 screen would be a button that appears to do nothing. -->
                            <div class="mz-zoombar" data-testid="mz-floor-zoom">
                                <span class="mz-zoomgrp" role="group" t-att-aria-label="zoomGroupLabel">
                                    <button type="button" class="mz-zoombtn" data-testid="mz-zoom-out"
                                            t-att-aria-label="zoomOutLabel"
                                            t-att-disabled="zoom &lt;= 0.7 ? 'disabled' : false"
                                            t-on-click="() => this.zoomOut()">−</button>
                                    <button type="button" class="mz-zoompct mz-num" data-testid="mz-zoom-pct"
                                            t-att-title="zoomFitLabel"
                                            t-on-click="() => this.zoomFit()" t-esc="zoomPct"/>
                                    <button type="button" class="mz-zoombtn" data-testid="mz-zoom-in"
                                            t-att-aria-label="zoomInLabel"
                                            t-att-disabled="zoom &gt;= 1.4 ? 'disabled' : false"
                                            t-on-click="() => this.zoomIn()">+</button>
                                </span>
                                <span class="mz-zoombar__hint" t-esc="zoomHint"/>
                            </div>
                        </div>

                        <!-- SIDE PANEL — fixed 320px, never reflows. -->
                        <aside class="mz-floorside" t-att-aria-label="tableDetailLabel">
                            <div class="mz-selcard" data-testid="mz-floor-selection">
                                <t t-if="selectedTable">
                                    <div class="mz-selcard__h">
                                        <span class="mz-selcard__no mz-num" t-esc="selectedTable.name"/>
                                        <span class="mz-selcard__st" t-esc="selectionStateLabel"/>
                                        <span class="mz-selcard__meta" t-esc="selectionMeta"/>
                                        <button type="button" class="mz-selcard__x"
                                                data-testid="mz-floor-deselect"
                                                t-att-aria-label="closeLabel"
                                                t-on-click="() => this.clearSelection()">✕</button>
                                    </div>
                                    <div t-if="selectionRows.length" class="mz-selrows">
                                        <div t-foreach="selectionRows" t-as="r" t-key="r.k" class="mz-selrow">
                                            <span class="mz-selrow__k" t-esc="r.k"/>
                                            <span class="mz-selrow__v" t-att-class="{ 'mz-num': r.money }" t-esc="r.v"/>
                                        </div>
                                    </div>
                                    <div t-if="selectionActions.length" class="mz-selacts">
                                        <button t-foreach="selectionActions" t-as="a" t-key="a.key"
                                                type="button" class="mz-btn"
                                                t-att-class="{ 'mz-btn--primary': a.primary }"
                                                t-att-data-floor-act="a.key"
                                                t-on-click="() => a.run()" t-esc="a.label"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <p class="mz-selcard__empty" t-esc="noSelectionHint"/>
                                </t>
                            </div>
                        </aside>
                    </div>
                </section>
            </t>

            </div><!-- /.mz-shell -->
                    </div><!-- /.mz-appbody -->
        </div>
    </t>

</templates>
