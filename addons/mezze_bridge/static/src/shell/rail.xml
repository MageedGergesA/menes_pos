<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The workspace rail, shared by Register, Floor and Kitchen so navigation never
         disappears when you walk between staff screens. -->
    <t t-name="mezze_bridge.WorkspaceRail">
        <nav class="mz-rail" aria-label="Workspaces">
            <a class="mz-rail__logo" href="/mezze/pos" aria-label="Mezze">
                <span class="mz-rail__mark" aria-hidden="true" t-esc="props.mark or 'M'"/>
            </a>
            <div class="mz-rail__group">
                <a t-foreach="items" t-as="item" t-key="item.key"
                   class="mz-rail__item"
                   t-att-class="{ 'mz-rail__item--active': item.active }"
                   t-att-href="item.href || false"
                   t-att-aria-current="item.active ? 'page' : false"
                   t-att-title="item.title" t-att-aria-label="item.title"
                   t-on-click="(ev) => this.onPick(ev, item)">
                    <span class="mz-rail__ico" aria-hidden="true" t-out="item.icon"/>
                    <span class="mz-rail__label" t-esc="item.label"/>
                </a>
            </div>
            <div class="mz-rail__foot">
                <a t-foreach="footItems" t-as="item" t-key="item.key"
                   class="mz-rail__item"
                   t-att-class="{ 'mz-rail__item--active': item.active }"
                   t-att-href="item.href || false"
                   t-att-aria-current="item.active ? 'page' : false"
                   t-att-title="item.title" t-att-aria-label="item.title"
                   t-on-click="(ev) => this.onPick(ev, item)">
                    <span class="mz-rail__ico" aria-hidden="true" t-out="item.icon"/>
                    <span class="mz-rail__label" t-esc="item.label"/>
                </a>
                <span class="mz-rail__avatar" t-att-title="props.userName" t-esc="initials"/>
            </div>
        </nav>
    </t>

</templates>
