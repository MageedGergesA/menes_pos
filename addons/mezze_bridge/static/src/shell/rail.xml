<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The workspace rail, shared by Register, Floor and Kitchen so navigation never
         disappears when you walk between staff screens. -->
    <t t-name="mezze_bridge.WorkspaceRail">
        <nav class="mz-rail" aria-label="Workspaces"
             t-att-class="{ 'mz-rail--wide': state.wide }">
            <a class="mz-rail__logo" href="/mezze/pos" aria-label="Mezze">
                <span class="mz-rail__mark" aria-hidden="true" t-esc="props.mark or 'M'"/>
            </a>
            <div class="mz-rail__group">
                <a t-foreach="items" t-as="item" t-key="item.key"
                   class="mz-rail__item"
                   t-att-class="{ 'mz-rail__item--active': item.active,
                                  'mz-rail__item--barred': item.barred }"
                   t-att-href="item.href || false"
                   t-att-aria-current="item.active ? 'page' : false"
                   t-att-aria-disabled="item.barred ? 'true' : false"
                   t-att-title="item.title" t-att-aria-label="accessibleName(item)"
                   t-on-click="(ev) => this.onPick(ev, item)">
                    <span class="mz-rail__ico" aria-hidden="true" t-out="item.icon"/>
                    <span class="mz-rail__label" t-esc="item.label"/>
                    <span t-if="countFor(item.key)" class="mz-rail__n"
                          data-testid="mz-rail-count" t-esc="countFor(item.key)"/>
                </a>
            </div>
            <div class="mz-rail__foot">
                <a t-foreach="footItems" t-as="item" t-key="item.key"
                   class="mz-rail__item"
                   t-att-class="{ 'mz-rail__item--active': item.active,
                                  'mz-rail__item--barred': item.barred }"
                   t-att-href="item.href || false"
                   t-att-aria-current="item.active ? 'page' : false"
                   t-att-aria-disabled="item.barred ? 'true' : false"
                   t-att-title="item.title" t-att-aria-label="accessibleName(item)"
                   t-on-click="(ev) => this.onPick(ev, item)">
                    <span class="mz-rail__ico" aria-hidden="true" t-out="item.icon"/>
                    <span class="mz-rail__label" t-esc="item.label"/>
                </a>
                <!-- DESIGN v3: the rail's own width control, where the design puts
                     it — at the foot, under the destinations it resizes. -->
                <button type="button" class="mz-rail__wide" data-testid="mz-rail-toggle"
                        t-att-aria-expanded="state.wide ? 'true' : 'false'"
                        t-att-aria-label="wideToggleLabel" t-att-title="wideToggleLabel"
                        t-on-click="() => this.toggleWide()">
                    <span class="mz-rail__ico" aria-hidden="true" t-esc="wideToggleGlyph"/>
                    <span class="mz-rail__label" t-esc="wideToggleLabel"/>
                </button>
                <!-- DESIGN v3: what the rail is NOT showing this person. Only drawn
                     when a branch policy is actually filtering something. -->
                <p t-if="roleFilteredNote" class="mz-rail__note"
                   data-testid="mz-rail-note" t-esc="roleFilteredNote"/>
            </div>
        </nav>
    </t>

</templates>
