<?xml version="1.0" encoding="UTF-8"?>
<!--
  The platform's own records, on screens a manager can actually open.

  Mezze grew as an API with its own front ends, and the back office was left
  behind: fifty-odd models, four with any view at all. That is fine right up to
  the first time something goes wrong on a Tuesday — a reservation nobody can
  find, a delivery stuck on a courier who went home, an aggregator order that
  never landed — and the only way to look is a shell and a SQL client.

  These are deliberately plain list-and-form screens rather than a designed
  console. What a manager needs here is to FIND a record, read it, and correct
  one field; anything more elaborate competes with the real surfaces (the
  Register, the Floor, the Kitchen) which are where the work actually happens.

  Everything is gated on the POS manager group: these records carry customer
  phone numbers and money.
-->
<odoo>

  <!-- ===================================================== front of house -->
  <record id="view_mezze_reservation_list" model="ir.ui.view">
    <field name="name">mezze.reservation.list</field>
    <field name="model">mezze.reservation</field>
    <field name="arch" type="xml">
      <list string="Reservations">
        <field name="start"/>
        <field name="customer_name"/>
        <field name="phone"/>
        <field name="guests"/>
        <field name="table_id"/>
        <field name="config_id"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="action_mezze_reservations" model="ir.actions.act_window">
    <field name="name">Reservations</field>
    <field name="res_model">mezze.reservation</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_mezze_waitlist_list" model="ir.ui.view">
