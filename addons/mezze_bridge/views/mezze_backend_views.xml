  <!-- ============================================================== audit -->
  <!--
    Read-only on purpose. An audit trail somebody can edit from the back office
    is not an audit trail, and the value of these rows is precisely that nobody
    can tidy them up after the fact.
  -->
  <record id="view_mezze_audit_log_list" model="ir.ui.view">
    <field name="name">mezze.audit.log.list</field>
    <field name="model">mezze.audit.log</field>
    <field name="arch" type="xml">
      <list string="Audit log" create="false" edit="false" delete="false">
        <field name="create_date"/>
        <field name="event"/>
        <field name="severity"/>
        <field name="cashier_id"/>
        <field name="user_id"/>
        <field name="config_id"/>
        <field name="res_model"/>
        <field name="res_id"/>
      </list>
    </field>
  </record>

  <record id="action_mezze_audit_log" model="ir.actions.act_window">
    <field name="name">Audit log</field>
    <field name="res_model">mezze.audit.log</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
  </record>

  <!-- =============================================================== menus -->
  <menuitem id="menu_mezze_root" name="Mezze"
